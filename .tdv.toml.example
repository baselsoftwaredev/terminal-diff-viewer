# Run tdv --setup to create a locally ignored .tdv.toml in each repository.
# With no config, or an empty languages array, syntax highlighting is off.
[syntax]
languages = ["csharp", "cpp", "rust"]

# Startup update checks are enabled by default. Set false to opt out.
[updates]
check_on_startup = true

# Reload Git changes in the background while the viewer is open.
[refresh]
auto = true

# Optional file-type icons. Select a Nerd Font v3+ in your terminal first.
[ui]
icons = false
